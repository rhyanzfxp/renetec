# ─── CONFIGURAÇÕES DE AMBIENTE (RENETEC BACKEND) ──────────────────────────────
# Exemplo seguro para deploy em produção — substitua pelos valores reais do servidor

NODE_ENV=production
PORT=3333
HOST=0.0.0.0

# URL de Conexão com Supabase / PostgreSQL (SSL obrigatório em produção)
DATABASE_URL="postgres://user:password@host:5432/db"
DIRECT_URL="postgres://user:password@host:5432/db"

# Chave Criptográfica JWT (Gere com: openssl rand -base64 32)
JWT_SECRET="GERE_UMA_CHAVE_SUPER_SECRETA_DE_32_BYTES_AQUI"

# Origens permitidas no CORS (ex: https://renetec.com.br,https://app.renetec.com.br)
CORS_ORIGIN="https://app.renetec.com.br"
